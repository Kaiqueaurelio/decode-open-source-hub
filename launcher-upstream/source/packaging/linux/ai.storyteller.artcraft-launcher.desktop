[Desktop Entry]
Type=Application
Name=ArtCraft Launcher
GenericName=App Launcher
Comment=Install, update and launch the Craft App Suite
Exec=artcraft-launcher
TryExec=artcraft-launcher
Icon=com.decode.artcraft-launcher
Terminal=false
StartupNotify=true
StartupWMClass=artcraft-launcher
Categories=Utility;PackageManager;
Keywords=artcraft;craft;launcher;installer;updater;photocraft;filmcraft;apps;


