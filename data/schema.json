{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decode Open Source Hub software record",
  "type": "array",
  "minItems": 20,
  "items": {
    "type": "object",
    "required": [
      "slug",
      "name",
      "icon",
      "category",
      "tagline",
      "description",
      "platforms",
      "license",
      "licenseUrl",
      "websiteUrl",
      "sourceUrl",
      "downloadUrl",
      "tags",
      "featured"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "icon": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "tagline": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "licenseUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "websiteUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "downloadUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "featured": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
