<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.decode.launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Decode Launcher</name>
  <summary>Install, update and launch the Decode App Suite</summary>
  <developer id="com.decode">
    <name>Decode Analytics</name>
  </developer>
  <description>
    <p>
      Decode Launcher lists every app in the Decode App Suite (DecodePhoto, DecodeLight, DecodeFilm,
      DecodeDesign, DecodeVector, DecodePdf, DecodeEffect, DecodeWord, DecodeDeck, DecodeGrid, DecodeCAD,
      DecodeSound and DecodeFig), installs the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every Decode app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.decode.launcher.desktop</launchable>
  <icon type="stock">com.decode.launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Kaiqueaurelio/decode-open-source-hub</url>
  <url type="bugtracker">https://github.com/Kaiqueaurelio/decode-open-source-hub/issues</url>
  <url type="help">https://github.com/Kaiqueaurelio/decode-open-source-hub</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>decode</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#0891b2</color>
    <color type="primary" scheme_preference="dark">#0f172a</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>decode-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
